              },
              {
                "name": "start",
                "value": "",
                "type": "query",
                "description": "Start time as Unix epoch (seconds)"
              },
              {
                "name": "end",
                "value": "",
                "type": "query",
                "description": "End time as Unix epoch (seconds)"
              },
              {
                "name": "step",
                "value": "",
                "type": "query",
                "description": "Query step interval (e.g., 30s, 1m, 5m)"
              }
