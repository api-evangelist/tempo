      "item": [
        {
          "id": "653f0887-61cf-4d5f-9b88-e2a48131c798",
          "name": "Query Metrics Range",
          "request": {
            "name": "Query Metrics Range",
            "description": {
              "content": "Generate time-series metrics from trace data using TraceQL metrics queries. Supports span rate, error rate, duration histograms, and custom metric generation from trace attributes.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "metrics",
                "query_range"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "q",
                  "value": "<string>",
                  "description": "(Required) TraceQL metrics query expression"
                },
                {
                  "disabled": false,
                  "key": "start",
                  "value": "<long>",
                  "description": "(Required) Start time as Unix epoch (seconds)"
                },
                {
                  "disabled": false,
                  "key": "end",
                  "value": "<long>",
                  "description": "(Required) End time as Unix epoch (seconds)"
                },
                {
                  "disabled": false,
                  "key": "step",
                  "value": "1m",
                  "description": "Query step interval (e.g., 30s, 1m, 5m)"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "6f7a7f90-a6ab-47af-b7f1-b1c620152a51",
              "name": "Metrics time-series data returned",
              "originalRequest": {
                "url": {
                  "path": [
                    "api",
                    "metrics",
                    "query_range"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [
                    {
                      "key": "q",
                      "value": "rate({.service.name=\"order-service\"}[5m])"
