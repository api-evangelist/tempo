          "name": "Search Traces",
          "request": {
            "name": "Search Traces",
            "description": {
              "content": "Search for traces matching a TraceQL query or tag-based filter. Returns a list of matching trace metadata with root span information, duration, and service names.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "search"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "q",
                  "value": "<string>",
                  "description": "TraceQL query string"
                },
                {
                  "disabled": false,
                  "key": "tags",
                  "value": "<string>",
                  "description": "URL-encoded logfmt tag filter (deprecated — use q with TraceQL instead). Example: service.name=frontend"
                },
                {
                  "disabled": false,
                  "key": "minDuration",
                  "value": "<string>",
                  "description": "Minimum trace duration filter (e.g., 100ms, 1s, 2m)"
                },
                {
                  "disabled": false,
                  "key": "maxDuration",
                  "value": "<string>",
                  "description": "Maximum trace duration filter (e.g., 100ms, 1s, 2m)"
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "20",
                  "description": "Maximum number of search results to return"
                },
                {
                  "disabled": false,
                  "key": "start",
                  "value": "<long>",
                  "description": "Unix epoch start time for search window (seconds)"
                },
                {
                  "disabled": false,
                  "key": "end",
                  "value": "<long>",
                  "description": "Unix epoch end time for search window (seconds)"
                }
              ],
              "variable": []
            },
            "header": [
